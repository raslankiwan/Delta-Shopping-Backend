# --- Database ---
# Application role: subject to RLS, NO BYPASSRLS. Used by the API for all tenant traffic.
DATABASE_URL="postgres://app_user:app_pass@localhost:5432/mercato"
# Privileged role: used ONLY by migrations and the isolation-test harness. Has BYPASSRLS.
DATABASE_ADMIN_URL="postgres://app_owner:owner_pass@localhost:5432/mercato"

# --- Redis (cache / sessions / BullMQ) ---
REDIS_URL="redis://localhost:9003"

# --- API ---
API_PORT=9000
NODE_ENV=development

# --- Storefront (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:9000/v1"

# --- Admin (Vite) ---
VITE_API_URL="http://localhost:9000/v1"

# --- Auth ---
JWT_SECRET="change-me-in-every-environment"
OPERATOR_TOKEN="set-a-strong-operator-token"
