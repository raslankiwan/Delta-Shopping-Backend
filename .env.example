# Server only. Never prefix this with NEXT_PUBLIC_.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=delta_shopping

# Optional approved payment connector (not bank API credentials).
APP_URL=https://delta-shopping.vercel.app
COMMERCE_GATEWAY_URL=
COMMERCE_GATEWAY_SECRET=
COMMERCE_GATEWAY_WEBHOOK_SECRET=
COMMERCE_PAYMENT_HOSTS=
# Random maintenance-job bearer secret; set identically in Vercel.
CRON_SECRET=

# Optional transactional email and account recovery (verified sender required).
RESEND_API_KEY=
EMAIL_FROM=
