{
  "name": "mercato",
  "version": "0.0.0",
  "private": true,
  "description": "Mercato \u2014 multi-tenant commerce platform (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "bun --env-file=.env run packages/db/src/migrate.ts",
    "db:seed": "bun --env-file=.env run packages/db/src/seed.ts",
    "db:studio": "bun --env-file=.env run --cwd packages/db studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "clean": "turbo run clean && rm -rf node_modules",
    "e2e": "bash scripts/dev.sh",
    "e2e:stop": "bash scripts/stop.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
