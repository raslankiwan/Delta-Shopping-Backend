{
  "name": "delta-shopping",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @delta/web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/*.integration.ts",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-admin.ts",
    "smoke": "node --env-file-if-exists=.env.local --import tsx scripts/smoke.ts",
    "smoke:commerce": "node --env-file-if-exists=.env.local --import tsx scripts/smoke-commerce.ts",
    "seed:commerce": "node --env-file-if-exists=.env.local --import tsx scripts/seed-commerce.ts",
    "payments:check": "node --env-file-if-exists=.env.local --import tsx scripts/payment-doctor.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mongodb": "7.7.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
